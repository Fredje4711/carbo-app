# Alleen serverinstellingen; vul echte sleutels in Vercel in, nooit in browsercode.
OPENAI_API_KEY=
OPENAI_VISION_MODEL=gpt-4o-mini
OPENAI_TRANSCRIPTION_MODEL=gpt-4o-mini-transcribe

# Optioneel: gedeelde limiet over alle Vercel-instanties.
# Zonder beide waarden blijft de bestaande limiet per instantie actief.
UPSTASH_REDIS_REST_URL=
UPSTASH_REDIS_REST_TOKEN=
ANALYSIS_DAILY_LIMIT=1000
TRANSCRIPTION_DAILY_LIMIT=1000

# Optionele extra origins, gescheiden door komma's.
ALLOWED_ORIGINS=
